#!/usr/bin/env php
<?php

if (PHP_VERSION_ID < 80200) {
    $root = __DIR__;
    $arguments = array_slice(isset($argv) ? $argv : array(), 1);
    $candidates = array();

    if (($php = getenv('PHP')) !== false && $php !== '') {
        $candidates[] = $php;
    }

    if (($phpBin = getenv('PHP_BIN')) !== false && $phpBin !== '') {
        $candidates[] = $phpBin;
    }

    $candidates = array_merge($candidates, array(
        '/opt/cpanel/ea-php83/root/usr/bin/php',
        '/opt/cpanel/ea-php82/root/usr/bin/php',
        '/usr/local/bin/php83',
        '/usr/local/bin/php82',
        '/opt/homebrew/bin/php',
        '/usr/local/bin/php',
    ));

    foreach ($candidates as $candidate) {
        if (! is_string($candidate) || $candidate === '' || ! is_executable($candidate)) {
            continue;
        }

        $versionId = (int) trim((string) shell_exec(escapeshellarg($candidate).' -r "echo PHP_VERSION_ID;" 2>/dev/null'));

        if ($versionId < 80200) {
            continue;
        }

        $command = escapeshellarg($candidate).' '.escapeshellarg($root.'/artisan');

        foreach ($arguments as $argument) {
            $command .= ' '.escapeshellarg($argument);
        }

        passthru($command, $exitCode);
        exit($exitCode);
    }

    fwrite(STDERR, "PHP 8.2+ is required.\n");
    fwrite(STDERR, "On cPanel try: /opt/cpanel/ea-php83/root/usr/bin/php artisan migrate --force\n");
    fwrite(STDERR, "Or set PHP=/path/to/php82 before running artisan.\n");
    exit(1);
}

require __DIR__.'/artisan-kernel.php';
