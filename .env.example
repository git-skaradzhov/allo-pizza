APP_NAME="Allo! Pizza"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Europe/Sofia
APP_URL=http://localhost

APP_LOCALE=bg
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=bg_BG

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pizzeria_orders
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@pizzeria.local"
MAIL_FROM_NAME="${APP_NAME}"

SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1

VITE_APP_NAME="${APP_NAME}"

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
# Real-time notifications (Filament admin only). On production hosting, either:
# - run a Reverb/WebSocket server and set the host below, or
# - leave as-is; the public site no longer opens a WebSocket connection.
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Google Maps JavaScript API key. In Google Cloud, restrict by HTTP referrer, e.g.:
# https://allopizza.skaradzhov.com/* and http://localhost:8000/*
GOOGLE_MAPS_API_KEY=

# Meta Conversions API. Put the Access Token only in the production .env — never commit it.
# Business Portfolio ID 1507578162592206 and Facebook Page ID 1168239656369371 are not used at runtime.
# Pixel/Dataset ID 1385265280465389 is stored in StoreSetting.meta_pixel_id (optional env fallback below).
META_PIXEL_ID=1385265280465389
META_CAPI_ENABLED=false
META_CAPI_ACCESS_TOKEN=
META_CAPI_API_VERSION=v26.0
META_CAPI_TEST_EVENT_CODE=
META_CAPI_TIMEOUT=3
